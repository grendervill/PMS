{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PMS",
  "version": "0.1.0",
  "identifier": "dev.pms.vault",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PMS",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#121614"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Локальный менеджер паролей",
    "longDescription": "Локальное зашифрованное хранилище паролей, TOTP-секретов и SSH-ключей."
  }
}
