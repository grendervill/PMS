# Домен, по которому к серверу будут ходить устройства.
PMS_DOMAIN=pms.home
# IP для SAN самоподписанного сертификата (можно оставить пустым при DNS-имени).
PMS_IP=192.168.1.10

# self-signed — сервер держит TLS сам; acme — TLS на Caddy (Let's Encrypt).
PMS_TLS=self-signed

# Только для acme: почта для Let's Encrypt.
ACME_EMAIL=

# Порт и адрес публикации (в acme-режиме сервер лучше не публиковать).
PMS_PORT=8443
PMS_BIND=0.0.0.0

# Тег образа — для откатов: поставьте прошлый тег и перезапустите.
PMS_TAG=latest
